/*

    R - index
    G - flower territory
    B - flower territory distance
    A - 

*/
// Soil (type 3): roots grow into soil cells. Root fields (s0 = 5 growable roots) are defined in
// res://voxel_data/schemas/type_2_plants.json; soil itself: res://voxel_data/schemas/type_3_soil.json
uvec4 check_flower_roots(uvec4[3][3][3] neighbors, uvec3 pos, uint seed) {
    uvec4 new_value = neighbors[1][1][1];
    float r = rand_fast(pos, seed);

    uvec4 roots = is_root_nearby(neighbors);
    uvec4 strongest_any = is_soil_territory_nearby(neighbors);
    uvec4 strongest_same = (new_value.g > 1u) ? is_soil_territory_nearby(neighbors, new_value.g) : uvec4(0u);
    
    if (roots.r != 0u) {
        FlowerData info = get_flower_data(roots.r);
        if (info.s1 > 1u) {
            new_value.g = info.s1;
            new_value.b = 10u;
        }
    } else if (new_value.g <= 1u) {
        if (strongest_any.r != 0u && strongest_any.g > 1u && strongest_any.b > 1u) {
            new_value.g = strongest_any.g;
            new_value.b = strongest_any.b - 1u;
        }
    } else {
        bool has_stronger_same = (strongest_same.r != 0u && strongest_same.b > new_value.b);
        bool has_stronger_other = (strongest_any.r != 0u && strongest_any.g != new_value.g && strongest_any.b > new_value.b);

        if (has_stronger_other) {
            new_value.g = strongest_any.g;
            new_value.b = strongest_any.b - 1u;
        } else if (strongest_same.r != 0u && strongest_same.b > 1u) {
            uint next_b = strongest_same.b - 1u;
            if (next_b > new_value.b) {
                new_value.b = next_b;
            }
        }
        
        if (!has_stronger_same && !has_stronger_other) {
            if (new_value.b > 1u) {
                new_value.b -= 1u;
            } else {
                new_value.g = 1u;
                new_value.b = 0u;
            }
        }
    }
    
    neighbors[1][1][1] = new_value;
    
    uvec4 directly_above = neighbors[1][2][1];
    if (is_flower_sub(directly_above, 0u)) { // Above is seed
        FlowerData seed_d = get_flower_data(directly_above.r);
        if (seed_d.s4 != 0u && directly_above.g > 1u) { // Create growable roots
            new_value.r = seed_d.s4;
            new_value.g = directly_above.g;
            new_value.b = pack_plant_size(1u, 0u);
            new_value.a = directly_above.a;
            return new_value;
        }
    }
    
    if (is_flower_sub(directly_above, 5u)) { // Directly above are growable roots
        FlowerData rd = get_flower_data(directly_above.r);
        float root_speed = float(rd.s4 > 0u ? rd.s4 : 30u) * 0.0001;
        uint max_depth = rd.s5 > 0u ? rd.s5 : 8u;
        uint max_branches = rd.s7 > 0u ? rd.s7 : 2u;

        uint current_depth = get_plant_height(directly_above.b);
        uint current_width = get_plant_spread(directly_above.b);
        uint roots_on_level = count_flower_on_Y_axis(neighbors, 1, 5u, 6u);

        if (current_depth < max_depth && roots_on_level < max_branches && r < root_speed) {
            new_value.r = directly_above.r;
            new_value.g = directly_above.g; // Free
            new_value.b = pack_plant_size(current_depth + 1u, current_width);
            new_value.a = directly_above.a; // Free
            return new_value;
        }
    }
    
    uvec4 side_root = search_flower_sideways(neighbors, 1, 5u); // Next to roots
    if (side_root.r != 0u) {
        FlowerData rd = get_flower_data(side_root.r);
        float side_root_speed = float(rd.s4 > 0u ? rd.s4 : 30u) * 0.00005;
        uint max_depth = rd.s5 > 0u ? rd.s5 : 8u;
        uint max_side_width = rd.s6 > 0u ? rd.s6 : 3u;
        uint max_branches = rd.s7 > 0u ? rd.s7 : 2u;

        uint current_depth = get_plant_height(side_root.b);
        uint current_width = get_plant_spread(side_root.b);
        uint roots_on_level = count_flower_on_Y_axis(neighbors, 1, 5u, 6u);
        
        //Create roots branch
        if (current_width < max_side_width && current_depth <= max_depth && roots_on_level < max_branches && r < side_root_speed) {
            new_value.r = side_root.r;
            new_value.g = side_root.g;
            new_value.b = pack_plant_size(current_depth, current_width + 1u);
            new_value.a = side_root.a;
            return new_value;
        }
    }

    return new_value;
}

uvec4 calculate_soil(uvec4[3][3][3] neighbors, uvec3 pos, uint seed) {
    return check_flower_roots(neighbors, pos, seed);
}