uvec4 check_flower(uvec4[3][3][3] neighbors, uvec3 pos, uint seed) {
    uvec4 new_value = neighbors[1][1][1];
    float r = rand_fast(pos, seed);
    
    uvec4 center_cardinal = search_flower_sideways(neighbors, 1, 3u);
    uvec4 center_any = search_for_flower_on_Y_axis(neighbors, 1, 3u);
    if (center_any.r != 0u) { // Next to center
        FlowerData cd = get_flower_data(center_any.r);
        float bloom_speed = float(cd.s4 > 0u ? cd.s4 : 10000u) * 0.0001;
        uint max_petal_radius = cd.s6 > 0u ? cd.s6 : 1u;

        // If max_petal_radius == 1, then create leaf only next to center
        bool can_place_petal = (max_petal_radius == 1u) ? (center_cardinal.r != 0u) : true;

        if (cd.s2 != 0u && can_place_petal && r < bloom_speed) {
            new_value.r = cd.s2;
            new_value.g = center_any.g; // Free 
            new_value.b = pack_plant_size(get_plant_height(center_any.b), 1u); // Setting distance to center to 1
            new_value.a = center_any.a; // Free
            return new_value;
        }
    }
    
    uvec4 center_up = search_flower_sideways(neighbors, 2, 3u); // Voxel diagonaly below the center
    if (center_up.r != 0u) {
        FlowerData cd = get_flower_data(center_up.r);
        uint crown_height = cd.s5 > 0u ? cd.s5 : 1u; //max crown heigth
        float bloom_speed = float(cd.s4 > 0u ? cd.s4 : 10000u) * 0.0001;

        if (cd.s2 != 0u && crown_height >= 2u && r < bloom_speed) {
            new_value.r = cd.s2;
            new_value.g = center_up.g; // Free
            new_value.b = pack_plant_size(get_plant_height(center_up.b), 1u); // Distance to center set to 1
            new_value.a = center_up.a; // Free
            return new_value;
        }
    }
    
    uvec4 side_leaf = search_flower_sideways(neighbors, 1, 4u); //Searching for leaf around
    if (side_leaf.r != 0u) {
        FlowerData ld = get_flower_data(side_leaf.r);
        uint current_radius = get_plant_spread(side_leaf.b); // Distance to center
        uint max_radius = ld.s6 > 0u ? ld.s6 : 1u; // Max distance to center
        float leaf_speed = float(ld.s4 > 0u ? ld.s4 : 20u) * 0.0001;

        if (ld.s2 != 0u && current_radius < max_radius && count_flower_on_Y_axis(neighbors, 1, 4u, 4u) <= 2u && r < leaf_speed) {
            new_value.r = ld.s2;
            new_value.g = side_leaf.g; // Free
            new_value.b = pack_plant_size(get_plant_height(side_leaf.b), current_radius + 1u); // Adding the distance
            new_value.a = side_leaf.a; // Free
            return new_value;
        }
    }
    
    uvec4 bottom_voxel = neighbors[1][0][1]; // Is growable stalk beneath
    if (is_flower_sub(bottom_voxel, 1u)) {
        FlowerData sd = get_flower_data(bottom_voxel.r);
        float grow_speed = float(sd.s4 > 0u ? sd.s4 : 10u) * 0.0001;
        uint max_height = sd.s5 > 0u ? sd.s5 : 12u;
        uint current_height = get_plant_height(bottom_voxel.b);
        uint current_spread = get_plant_spread(bottom_voxel.b);

        if (current_spread == 0u) { // Main axis of flower
            if (current_height >= max_height) { // Can't grow taller
                if (sd.s3 != 0u && count_flower_in_box(neighbors, 3u) == 0u && r < grow_speed) { // check for generating the flower center
                    new_value.r = sd.s3;
                    new_value.g = bottom_voxel.g; // Free
                    new_value.b = pack_plant_size(current_height + 1u, 0u);
                    new_value.a = bottom_voxel.a; // Free
                    return new_value;
                }
            } else if (r < grow_speed && count_flower_on_Y_axis(neighbors, 1, 1u, 2u) == 0u) { // check for growing the stalk
                new_value.r = bottom_voxel.r;
                new_value.g = bottom_voxel.g; // Free
                new_value.b = pack_plant_size(current_height + 1u, 0u);
                new_value.a = bottom_voxel.a; // Free
                return new_value;
            }
        } else { // Branch of the flower
            uint taper = (current_height > 2u) ? ((current_height - 2u) / 2u) : 0u; // Gemini help
            uint target_spread = (sd.s6 > taper + 1u) ? (sd.s6 - taper) : 1u;

            if (current_spread >= target_spread && sd.s3 != 0u && r < grow_speed) {
                if (count_flower_in_box(neighbors, 3u) == 0u &&
                    count_flower_in_box(neighbors, 4u) == 0u &&
                    count_flower_on_Y_axis(neighbors, 1, 1u, 2u) <= 1u) {
                    new_value.r = sd.s3;
                    new_value.g = bottom_voxel.g;
                    new_value.b = pack_plant_size(current_height + 1u, current_spread);
                    new_value.a = bottom_voxel.a;
                    return new_value;
                }
            }
        }
    }
    
    if (is_flower_sub(bottom_voxel, 0u)&& bottom_voxel.g != 1u) { // Below is seed
        FlowerData seed_d = get_flower_data(bottom_voxel.r);
        float germ_speed = float(seed_d.s5 > 0u ? seed_d.s5 : 1u) * 0.0001;

        if (seed_d.s2 != 0u && r < germ_speed) {
            new_value.r = seed_d.s2;
            new_value.g = bottom_voxel.g; // Free
            new_value.b = pack_plant_size(2u, 0u);
            new_value.a = bottom_voxel.a; // Free
            return new_value;
        }
    }
    
    bool along_x = false;
    ivec2 dir_to_stalk = ivec2(0, 0);
    uvec4 side_stalk = search_stalk_sideways(neighbors, 1, along_x, dir_to_stalk); // searching for stalk next to voxel

    if (side_stalk.r != 0u && neighbors[1][0][1].r == 0u && neighbors[1][2][1].r == 0u) { // next to is a growable stalk, and upper and lower neighboard is air
        FlowerData sd = get_flower_data(side_stalk.r);
        uint max_height = sd.s5 > 0u ? sd.s5 : 12u;
        uint max_buds = sd.s7 > 0u ? sd.s7 : 1u; // Max number of branches
        float side_speed = float(sd.s4 > 0u ? sd.s4 : 10u) * 0.00008;

        bool clean_space = (count_flower_on_Y_axis(neighbors, 1, 1u, 2u) == 1u) && // Searching for open space
        (count_flower_in_box(neighbors, 3u) == 0u) &&
        (count_flower_in_box(neighbors, 4u) == 0u);

        if (sd.s6 > 0u && clean_space && r < side_speed) { // sideway spread > 0, can grow and have space
            uint stalk_height = get_plant_height(side_stalk.b);
            uint current_spread = get_plant_spread(side_stalk.b);
            uint taper = (stalk_height > 2u) ? ((stalk_height - 2u) / 2u) : 0u;
            uint target_spread = (sd.s6 > taper + 1u) ? (sd.s6 - taper) : 1u;

            if (current_spread == 0u) { // Gemini help
                uint tier_index = (stalk_height >= 2u) ? ((stalk_height / 2u) - 1u) : 99u;
                uint max_tiers = (max_buds > 1u) ? (max_buds / 2u) : 0u;

                uint trunk_x = uint(int(pos.x) + dir_to_stalk.x);
                uint trunk_z = uint(int(pos.z) + dir_to_stalk.y);
                uint axis_parity = (tier_index + ((trunk_x + trunk_z) & 1u)) & 1u;
                bool allowed_axis = (axis_parity == 0u) ? along_x : !along_x;

                if ((stalk_height % 2u) == 0u && stalk_height < max_height &&
                    tier_index < max_tiers && allowed_axis && current_spread < target_spread) {
                    new_value.r = (sd.s0 == 1u) ? side_stalk.r : sd.s2;
                    new_value.g = side_stalk.g;
                    new_value.b = pack_plant_size(stalk_height, 1u);
                    new_value.a = side_stalk.a;
                    return new_value;
                }
            } else if (sd.s0 == 1u && current_spread < target_spread) {
                new_value.r = side_stalk.r;
                new_value.g = side_stalk.g;
                new_value.b = pack_plant_size(stalk_height, current_spread + 1u);
                new_value.a = side_stalk.a;
                return new_value;
            }
        }
    }

    return new_value;
}

uvec4 check_falling_blocks(uvec4[3][3][3] neighbors, uint seed){
    uvec4 new_value = neighbors[1][1][1];

    uint type_above = (neighbors[1][2][1].r >> 11u) & 0x1Fu;
    if (type_above == 4u) {
        return neighbors[1][2][1];
    }

    ivec2 dir = get_diagonal_dir(seed);
    int src_x = 1 - dir.x;
    int src_z = 1 - dir.y;

    uvec4 diag_block = neighbors[src_x][2][src_z];
    uint type_diag = (diag_block.r >> 11u) & 0x1Fu;

    if (type_diag == 4u && neighbors[src_x][1][src_z].r != 0u) {
        uvec4 rawInput = dataArray[diag_block.r].packedData;
        uint s1 = bitfieldExtract(rawInput.x, 16, 16);

        if (s1 != 0u) {
            new_value = diag_block;
        }
    }

    return new_value;
}

uvec4 calculate_air(uvec4[3][3][3] neighbors, uvec3 pos, uint seed){
    uvec4 new_value = neighbors[1][1][1];

    new_value = check_falling_blocks(neighbors, seed);

    if(new_value.r != 0u)
    return new_value;

    new_value = check_flower(neighbors, pos, seed);

    return new_value;
}