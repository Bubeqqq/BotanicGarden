// GLOBAL

uvec4 check_voxels_on_Y_axis(int y, uint index, uvec4[3][3][3] neighbors){
    for(int x = 0; x < 3; x++){
        for(int z = 0; z < 3; z++){
            if(neighbors[x][y][z].r == index){
                return neighbors[x][y][z];
            }
        }
    }
    return uvec4(0u);
}

uint pcg_hash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand_fast(uvec3 pos, uint frame_seed) {
    uint seed = pos.x * 1664525u + pos.y * 1013904223u + pos.z * 374761393u + frame_seed * 2246822519u;
    return float(pcg_hash(seed)) * (1.0 / 4294967295.0);
}

uint get_next_plant_index(){
    return atomicAdd(next_plant_id, 1u);
}

// FLOWERS

struct FlowerData {
    uint s0, s1, s2, s3, s4, s5, s6, s7;
};

FlowerData get_flower_data(uint index) {
    uvec4 raw = dataArray[index].packedData;
    FlowerData d;
    d.s0 = bitfieldExtract(raw.x, 0, 16);
    d.s1 = bitfieldExtract(raw.x, 16, 16);
    d.s2 = bitfieldExtract(raw.y, 0, 16);
    d.s3 = bitfieldExtract(raw.y, 16, 16);
    d.s4 = bitfieldExtract(raw.z, 0, 16);
    d.s5 = bitfieldExtract(raw.z, 16, 16);
    d.s6 = bitfieldExtract(raw.w, 0, 16);
    d.s7 = bitfieldExtract(raw.w, 16, 16);
    return d;
}

uvec4 is_root_nearby(uvec4[3][3][3] neighbors){
    for (int x = 0; x < 3; x++) {
        for (int y = 0; y < 3; y++) {
            for (int z = 0; z < 3; z++) {
                if(x == 1 && y == 1 && z == 1){
                    continue;
                }
                
                uint r = neighbors[x][y][z].r;
                uint type = (r >> 11) & 0x1F;
                if(type == 2){
                    uint s0 = get_flower_data(r).s0;
                    
                    if(s0 == 5 || s0 == 6){
                        return neighbors[x][y][z];
                    }
                }
            }
        }
    }
    
    return uvec4(0u);
}

uvec4 is_soil_territory_nearby(uvec4[3][3][3] neighbors) {
    uvec4 best = uvec4(0u);
    uint best_b = 0u;

    for (int x = 0; x < 3; x++) {
        for (int y = 0; y < 3; y++) {
            for (int z = 0; z < 3; z++) {
                if (x == 1 && y == 1 && z == 1) {
                    continue;
                }

                uvec4 nb = neighbors[x][y][z];
                uint type = (nb.r >> 11) & 0x1Fu;

                if (type == 3u && nb.g > 1u && nb.b > best_b) {
                    best_b = nb.b;
                    best = nb;
                }
            }
        }
    }

    return best;
}

uvec4 is_soil_territory_nearby(uvec4[3][3][3] neighbors, uint territory_index) {
    uvec4 best = uvec4(0u);
    uint best_b = 0u;

    for (int x = 0; x < 3; x++) {
        for (int y = 0; y < 3; y++) {
            for (int z = 0; z < 3; z++) {
                if (x == 1 && y == 1 && z == 1) {
                    continue;
                }

                uvec4 nb = neighbors[x][y][z];
                uint type = (nb.r >> 11) & 0x1Fu;

                if (type == 3u && nb.g > 1u && nb.b > best_b && nb.g == territory_index) {
                    best_b = nb.b;
                    best = nb;
                }
            }
        }
    }

    return best;
}

bool is_flower_sub(uvec4 voxel, uint target_s0) {
    uint type = (voxel.r >> 11u) & 0x1Fu;
    if (type != 2u) return false;
    uint s0 = bitfieldExtract(dataArray[voxel.r].packedData.x, 0, 16);
    return s0 == target_s0;
}

uvec4 search_for_flower_on_Y_axis(uvec4[3][3][3] neighbors, int y, uint s0){
    for(int x = 0; x < 3; x++){
        for(int z = 0; z < 3; z++){
            if(is_flower_sub(neighbors[x][y][z], s0)){
                return neighbors[x][y][z];
            }
        }
    }
    return uvec4(0u);
}

uvec4 search_for_flower_on_Y_axis(uvec4[3][3][3] neighbors, int y, uint s0, uint s0_2){
    for(int x = 0; x < 3; x++){
        for(int z = 0; z < 3; z++){
            if(is_flower_sub(neighbors[x][y][z], s0) || is_flower_sub(neighbors[x][y][z], s0_2)){
                return neighbors[x][y][z];
            }
        }
    }
    return uvec4(0u);
}

uint count_flower_in_box(uvec4[3][3][3] neighbors, uint s0) {
    uint count = 0u;
    for (int x = 0; x < 3; x++) {
        for (int y = 0; y < 3; y++) {
            for (int z = 0; z < 3; z++) {
                if (is_flower_sub(neighbors[x][y][z], s0)) {
                    count++;
                }
            }
        }
    }
    return count;
}

uint count_flower_on_Y_axis(uvec4[3][3][3] neighbors, int y, uint s0, uint s0_2) {
    uint count = 0u;
    for (int x = 0; x < 3; x++) {
        for (int z = 0; z < 3; z++) {
            if (is_flower_sub(neighbors[x][y][z], s0) || is_flower_sub(neighbors[x][y][z], s0_2)) {
                count++;
            }
        }
    }
    return count;
}

uvec4 search_flower_sideways(uvec4[3][3][3] neighbors, int y, uint s0) {
    const ivec2 dirs[4] = ivec2[4](ivec2(0, 1), ivec2(2, 1), ivec2(1, 0), ivec2(1, 2));
    for (int i = 0; i < 4; i++) {
        uvec4 cand = neighbors[dirs[i].x][y][dirs[i].y];
        if (is_flower_sub(cand, s0)) {
            return cand;
        }
    }
    return uvec4(0u);
}

uvec4 search_stalk_sideways(uvec4[3][3][3] neighbors, int y, out bool along_x, out ivec2 dir_to_stalk) {
    const ivec2 dirs[4] = ivec2[4](ivec2(0, 1), ivec2(2, 1), ivec2(1, 0), ivec2(1, 2));
    for (int i = 0; i < 4; i++) {
        uvec4 cand = neighbors[dirs[i].x][y][dirs[i].y];
        if (is_flower_sub(cand, 1u) || is_flower_sub(cand, 2u)) {
            along_x = (i < 2);
            dir_to_stalk = ivec2(dirs[i].x - 1, dirs[i].y - 1);
            return cand;
        }
    }
    along_x = false;
    dir_to_stalk = ivec2(0, 0);
    return uvec4(0u);
}

uint get_plant_height(uint b_channel) {
    return bitfieldExtract(b_channel, 0, 8);
}

uint get_plant_spread(uint b_channel) {
    return bitfieldExtract(b_channel, 8, 8);
}

uint pack_plant_size(uint height, uint spread) {
    return (min(height, 255u) & 0xFFu) | ((min(spread, 255u) & 0xFFu) << 8u);
}

bool has_extended_sideways(uvec4[3][3][3] neighbors, uint current_spread) {
    const ivec2 dirs[4] = ivec2[4](ivec2(0, 1), ivec2(2, 1), ivec2(1, 0), ivec2(1, 2));
    for (int i = 0; i < 4; i++) {
        uvec4 cand = neighbors[dirs[i].x][1][dirs[i].y];
        if ((is_flower_sub(cand, 1u) || is_flower_sub(cand, 2u)) &&
            get_plant_spread(cand.b) == current_spread + 1u) {
            return true;
        }
    }
    return false;
}

// Falling blocks

ivec2 get_diagonal_dir(uint seed) {
    uint dir = seed & 3u;
    if (dir == 0u) return ivec2(1, 0);
    if (dir == 1u) return ivec2(-1, 0);
    if (dir == 2u) return ivec2(0, 1);
    return ivec2(0, -1);
}