/*

Plant voxels (type 2). What s0..s7 mean for each plant part (s0) is defined in
res://voxel_data/schemas/type_2_plants.json (labels, defaults, speed scales, which part an
index field must point at). The block editor reads that file. Update it when changing
the rules here, in air.glslinc (check_flower), in soil.glslinc (check_flower_roots) or
in Analysis.glsl (reads s1 as the species id).

s0: 0 seed, 1 growable stalk, 2 stalk, 3 flower center, 4 flower leaf, 5 growable roots, 6 roots

*/
uvec4 calculate_flower(uvec4[3][3][3] neighbors, uvec3 pos, uint seed) {
    uvec4 new_value = neighbors[1][1][1];
    FlowerData d = get_flower_data(new_value.r);
    float r = rand_fast(pos, seed);

    if (d.s0 == 1u) { // growable stalk
        bool has_grown_above = is_flower_sub(neighbors[1][2][1], 1u) ||
        is_flower_sub(neighbors[1][2][1], 2u) ||
        is_flower_sub(neighbors[1][2][1], 3u);

        uint current_spread = get_plant_spread(new_value.b);
        bool branch_continued = (current_spread > 0u) && has_extended_sideways(neighbors, current_spread);

        if (has_grown_above || branch_continued) {
            if (d.s2 != 0u) {
                new_value.r = d.s2;
            }
        }
    } else if (d.s0 == 5u) { // growable roots
        float stop_speed = float(d.s4 > 0u ? d.s4 : 60u) * 0.0001;
        uint max_depth = d.s5 > 0u ? d.s5 : 8u;
        uint current_depth = get_plant_height(new_value.b);

        bool has_root_below = is_flower_sub(neighbors[1][0][1], 5u) ||
        is_flower_sub(neighbors[1][0][1], 6u);

        if (has_root_below || current_depth >= max_depth) {
            if (r < stop_speed && d.s2 != 0u) {
                new_value.r = d.s2;
            }
        }
    } else if (d.s0 == 0u) { // seed
        if(new_value.g <= 1){
            new_value.g = get_next_plant_index();
        }else{
            if (is_flower_sub(neighbors[1][2][1], 1u) || is_flower_sub(neighbors[1][2][1], 2u)) {
                if (d.s3 != 0u) {
                    new_value.r = d.s3;
                }
            }
        }
    }

    return new_value;
}