// GLOBAL

ivec4 check_voxels_on_Y_axis(int y, int index, ivec4[3][3][3] neighbors){
    for(int x = 0; x < 3; x++){
        for(int z = 0; z < 3; z++){
            if(neighbors[x][y][z].r == index){
                return neighbors[x][y][z];
            }
        }
    }
    return ivec4(0, 0, 0, 0);
}

uint pcg_hash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand_fast(uvec3 pos, uint frame_seed) {
    uint seed = pos.x * 1664525u + pos.y * 1013904223u + pos.z * 374761393u + frame_seed * 2246822519u;
    return float(pcg_hash(seed)) * (1.0 / 4294967295.0);
}

uint get_next_plant_index(){
    uint next = next_plant_id;
    next_plant_id = next_plant_id + 1;
    return next;
}

//FLOWERS

ivec4 search_for_flower_on_Y_axis(ivec4[3][3][3] neighbors, int y, int s0){
    for(int x = 0; x < 3; x++){
        for(int z = 0; z < 3; z++){
            uint type = (neighbors[x][y][z].r >> 11u) & 0x1Fu;
            int s0_index = bitfieldExtract(dataArray[neighbors[x][y][z].r].packedData.x, 0, 16);

            if(type == 2u && s0_index == s0){
                return neighbors[x][y][z];
            }
        }
    }
    return ivec4(0, 0, 0, 0);
}

ivec4 search_for_flower_on_Y_axis(ivec4[3][3][3] neighbors, int y, int s0, int s0_2){
    for(int x = 0; x < 3; x++){
        for(int z = 0; z < 3; z++){
            uint type = (neighbors[x][y][z].r >> 11u) & 0x1Fu;
            int s0_index = bitfieldExtract(dataArray[neighbors[x][y][z].r].packedData.x, 0, 16);

            if(type == 2u && (s0_index == s0 || s0_index == s0_2)){
                return neighbors[x][y][z];
            }
        }
    }
    return ivec4(0, 0, 0, 0);
}

// Falling blocks

ivec2 get_diagonal_dir(uint seed) {
    uint dir = seed & 3u;
    if (dir == 0u) return ivec2(1, 0);
    if (dir == 1u) return ivec2(-1, 0);
    if (dir == 2u) return ivec2(0, 1);
    return ivec2(0, -1);
}