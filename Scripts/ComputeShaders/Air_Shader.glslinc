ivec4 check_flower(ivec4[3][3][3] neighbors, uvec3 pos, uint seed, uint current_index){
	ivec4 new_value = neighbors[1][1][1];

	ivec4 rawInput = dataArray[current_index].packedData;
	
	int s0 = bitfieldExtract(rawInput.x, 0, 16);
	int s1 = bitfieldExtract(rawInput.x, 16, 16);

	int s2 = bitfieldExtract(rawInput.y, 0, 16);
	int s3 = bitfieldExtract(rawInput.y, 16, 16);

	int s4 = bitfieldExtract(rawInput.z, 0, 16);
	int s5 = bitfieldExtract(rawInput.z, 16, 16);

	int s6 = bitfieldExtract(rawInput.w, 0, 16);
	int s7 = bitfieldExtract(rawInput.w, 16, 16);

	if(check_voxels_on_Y_axis(1, 4098, neighbors).r != 0)
	{
		new_value.r = 4099;
	}

	if(check_voxels_on_Y_axis(2, 4098, neighbors).r != 0)
	{
		new_value.r = 4099;
	}

	if(check_voxels_on_Y_axis(1, 4096, neighbors).r == 0){
		ivec4 bottom = check_voxels_on_Y_axis(0, 4096, neighbors);
		if(bottom.r != 0){
			float r = rand_fast(pos, seed);

			if(r < 0.001){
				new_value.r = 4096;
				new_value.b = bottom.b + 1;
			}else if(r > 1.0 - (0.0001 * float(neighbors[1][1][1].b))){
				new_value.r = 4098;
			}
		}
	}

	return new_value;
}

