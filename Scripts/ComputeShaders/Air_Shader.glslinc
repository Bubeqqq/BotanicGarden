ivec4 check_flower(ivec4[3][3][3] neighbors, uvec3 pos, uint seed){
	ivec4 new_value = neighbors[1][1][1];

	/*ivec4 rawInput = dataArray[current_index].packedData;
	
	int s0 = bitfieldExtract(rawInput.x, 0, 16);
	int s1 = bitfieldExtract(rawInput.x, 16, 16);

	int s2 = bitfieldExtract(rawInput.y, 0, 16);
	int s3 = bitfieldExtract(rawInput.y, 16, 16);

	int s4 = bitfieldExtract(rawInput.z, 0, 16);
	int s5 = bitfieldExtract(rawInput.z, 16, 16);

	int s6 = bitfieldExtract(rawInput.w, 0, 16);
	int s7 = bitfieldExtract(rawInput.w, 16, 16);*/

	int index = search_for_flower_on_Y_axis(neighbors, 1, 3).r;
	if(index != 0) // check for center of flower, on the same level as the voxel
	{
		int s2 = bitfieldExtract(dataArray[index].packedData.y, 0, 16); // flower leaf
		new_value.r = s2;
	}

	index = search_for_flower_on_Y_axis(neighbors, 2, 3).r;
	if(index != 0) // check for center of flower, up the voxel
	{
		int s2 = bitfieldExtract(dataArray[index].packedData.y, 0, 16); // flower leaf
		new_value.r = s2;
	}

	if(search_for_flower_on_Y_axis(neighbors, 1, 1, 2).r == 0){ // check if the stalk have the space to grow
		ivec4 bottom = search_for_flower_on_Y_axis(neighbors, 0, 1); // check for growable stalk under the voxel
		if(bottom.r != 0){
			ivec4 rawInput = dataArray[bottom.r].packedData;
			int s3 = bitfieldExtract(rawInput.y, 16, 16); // center
			
			float r = rand_fast(pos, seed);

			if(r < 0.001){ //check for growth
				new_value.r = bottom.r;
				new_value.b = bottom.b + 1;
			}else if(r > 1.0 - (0.0001 * float(neighbors[1][1][1].b))){ // check for creating a flower center
				new_value.r = s3;
			}
		}else{
			bottom = search_for_flower_on_Y_axis(neighbors, 0, 0); // check for seed under 
			if(bottom.r != 0){
				ivec4 rawInput = dataArray[bottom.r].packedData;
				int s2 = bitfieldExtract(rawInput.y, 0, 16); // center

				float r = rand_fast(pos, seed);

				if(r < 0.0001){ //check for germination
					new_value.r = s2;
					new_value.b = bottom.b + 1;
				}
			}   
		}
	}

	return new_value;
}

ivec4 check_falling_blocks(ivec4[3][3][3] neighbors, uint seed){
	ivec4 new_value = neighbors[1][1][1];
	
	uint type_above = (neighbors[1][2][1].r >> 11u) & 0x1Fu;
	if (type_above == 4u) {
		return neighbors[1][2][1];
	}
	
	ivec2 dir = get_diagonal_dir(seed);
	int src_x = 1 - dir.x;
	int src_z = 1 - dir.y;

	ivec4 diag_block = neighbors[src_x][2][src_z];
	uint type_diag = (diag_block.r >> 11u) & 0x1Fu;
	
	if (type_diag == 4u && neighbors[src_x][1][src_z].r != 0) {
		ivec4 rawInput = dataArray[diag_block.r].packedData;
		int s1 = bitfieldExtract(rawInput.x, 16, 16);

		if (s1 != 0) {
			new_value = diag_block;
		}
	}

	return new_value;
}

ivec4 calculate_air(ivec4[3][3][3] neighbors, uvec3 pos, uint seed){
	ivec4 new_value = neighbors[1][1][1];

	new_value = check_flower(neighbors, pos, seed);
	
	if(new_value.r != 0)
		return new_value;
	
	new_value = check_falling_blocks(neighbors, seed);
	
	return new_value;

}
