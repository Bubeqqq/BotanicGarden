/*

Normal Flower types:

s0 -> flower sub-index
s1 -> flower index

s0 = 0 -> seed
    s2 -> growable stalk index
    s3 -> stalk index

s0 = 1 -> growable stalk
    s2 -> stalk index
    s3 -> flower center
    
s0 = 2 -> stalk

s0 = 3 -> flower center
    s2 -> flower leaf

s0 = 4 -> flower leaf

*/
ivec4 calculate_flower(ivec4[3][3][3] neighbors, uvec3 pos, uint seed){
    ivec4 new_value = neighbors[1][1][1];
    ivec4 rawInput = dataArray[new_value.r].packedData;
    int s0 = bitfieldExtract(rawInput.x, 0, 16);
    int s2 = bitfieldExtract(rawInput.y, 0, 16);
    int s3 = bitfieldExtract(rawInput.y, 16, 16);
    
    if(s0 == 1){
        if(search_for_flower_on_Y_axis(neighbors, 2, 1).r != 0){
            float r = rand_fast(pos, seed);

            if(r < 0.003f * float(neighbors[1][1][1].b)){
                new_value.r = s2;
            }
        }

        if(check_voxels_on_Y_axis(2, s3, neighbors).r != 0)
        {
            new_value.r = s2;
        }
    }

//    if(neighbors[1][1][1].r == 4096){
//        if(check_voxels_on_Y_axis(2, 4096, neighbors).r != 0){
//            float r = rand_fast(pos, seed);
//
//            if(r < 0.003f * float(neighbors[1][1][1].b)){
//                new_value.r = 4097;
//            }
//        }
//
//        if(check_voxels_on_Y_axis(2, 4098, neighbors).r != 0)
//        {
//            new_value.r = 4097;
//        }
//    }
    
    return new_value;
}