/*

Normal Flower types:

s0 -> flower sub-index
s1 -> flower index

s0 = 0 -> seed
    s2 -> growable stalk index
    s3 -> stalk index
    s4 -> growable roots

s0 = 1 -> growable stalk
    s2 -> stalk index
    s3 -> flower center
    
s0 = 2 -> stalk

s0 = 3 -> flower center
    s2 -> flower leaf

s0 = 4 -> flower leaf

s0 = 5 -> growable roots
    s2 -> roots

s0 = 6 -> roots

*/
uvec4 calculate_flower(uvec4[3][3][3] neighbors, uvec3 pos, uint seed){
    uvec4 new_value = neighbors[1][1][1];
    uvec4 rawInput = dataArray[new_value.r].packedData;
    uint s0 = bitfieldExtract(rawInput.x, 0, 16);
    uint s2 = bitfieldExtract(rawInput.y, 0, 16);
    uint s3 = bitfieldExtract(rawInput.y, 16, 16);
    
    if(s0 == 1){ // growable stalk
        if(search_for_flower_on_Y_axis(neighbors, 2, 1).r != 0){
            float r = rand_fast(pos, seed);

            if(r < 0.003f * float(neighbors[1][1][1].b)){ // check for stop growing if there is stalk next to
                new_value.r = s2;
            }
        }
    }else if(s0 == 5){ //growable roots
        if(search_for_flower_on_Y_axis(neighbors, 0, 5, 6).r != 0){
            float r = rand_fast(pos, seed);

            if(r < 0.006f){ // check for stop growing if there is stalk next to
                new_value.r = s2;
            }
        }
    }else if(s0 == 0){ //seed
        if(search_for_flower_on_Y_axis(neighbors, 2, 1, 2).r != 0){ // already grown
            new_value.r = s3; //change to stalk
        }
    }
    
    return new_value;
}